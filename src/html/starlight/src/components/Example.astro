---
// The examples of a symbol: overlunky's docs/examples/<name>.md|.lua, then docs-digger's examples/<kind>/<name>.
import Doc from './Doc.astro';
import {examplesOf} from '../lib/api.mjs';

interface Props {
    // Which page kind the symbol lives on, the top directory of docs-digger's examples/ (`functions`, `types`,
    // `enums`, `events`, `globals`, `text`): names differ only in case across kinds (`Door` type, `door` function).
    kind: string;
    // Symbol name as the example file is named (`spawn_entity`, `ON.LEVEL`, `CustomTheme`, `Entity.destroy`).
    name: string;
}
const texts = examplesOf(Astro.props.kind, Astro.props.name);
---

{
    texts.map((text) => (
        <div class="dd-example">
            <Doc lines={text} />
        </div>
    ))
}
